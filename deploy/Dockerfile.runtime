# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.9.7 AS uv
FROM python:3.12-slim-trixie AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never
WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable

FROM python:3.12-slim-trixie AS runtime
ARG VT_SOURCE_REVISION=unrecorded
LABEL org.opencontainers.image.revision=$VT_SOURCE_REVISION
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg librubberband3 fontconfig fonts-noto-core fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W -f '${Version}\n' librubberband3 | grep -E '^4\.0\.0([+~.-]|$)'
# Build-time font tooling / libass availability for the forthcoming subtitle slice.
RUN command -v fc-match && command -v fc-query \
    && fc-match -f '%{family}\n' 'Noto Sans' | grep -F 'Noto Sans' \
    && fc-match -f '%{family}\n' 'Noto Sans CJK SC' | grep -F 'Noto Sans CJK' \
    && ffmpeg -hide_banner -filters 2>/dev/null | grep -E '(^|[[:space:]])subtitles[[:space:]]'
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY alembic.ini ./
COPY alembic ./alembic
# Installed package, its exact runner file, offline language data, and real R3 engine.
RUN python -c 'from pathlib import Path; from videotranslate.media import offline_warp_runner as r; from videotranslate.languages.catalog import catalog; assert "site-packages" in r.__file__; assert Path(r.__file__).is_file(); assert len(catalog())>600; lib=r.library(); state=lib.rubberband_new(48000,2,0x20000000|0x00010000|0x10000000,1.0,1.0); assert state and lib.rubberband_get_engine_version(state)==3; lib.rubberband_delete(state)'
RUN ffmpeg -nostdin -v error -f lavfi -i color=s=16x16:r=25 \
    -f lavfi -i anullsrc=r=48000:cl=stereo -t 0.04 \
    -c:v libx264 -pix_fmt yuv420p -c:a aac /tmp/codec-check.mp4 \
    && ffmpeg -nostdin -v error -i /tmp/codec-check.mp4 -vn -map 0:a:0 -c:a libmp3lame /tmp/codec-check.mp3 \
    && rm /tmp/codec-check.mp4 /tmp/codec-check.mp3 \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --home-dir /app app
USER 10001:10001
EXPOSE 8000
# Safe standalone default: Compose enables headers only for its fixed internal Web IP.
CMD ["uvicorn", "videotranslate.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
