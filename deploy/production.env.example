# Copy to the git-ignored root .env.production; fill all blanks before starting.
# This is production configuration, never a SQLite/local-storage fallback.
VT_ENVIRONMENT=production
VT_DEBUG=false
VT_DATABASE_URL=postgresql+psycopg://vt_app:URL_ENCODED_PASSWORD@postgres.example.net/videotranslate?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
VT_STORAGE_BACKEND=s3
VT_SERVER_SECRET=
VT_PUBLIC_ORIGIN=https://video.example.com
VT_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
VT_S3_BUCKET=
VT_S3_REGION=us-east-1
VT_S3_ACCESS_KEY=
VT_S3_SECRET_KEY=
VT_UPLOAD_MAX_BYTES=536870912
VT_PROBE_MAX_BYTES=536870912
VT_PROBE_MAX_DURATION_SECONDS=14400
VT_PROBE_MAX_PIXELS=33177600
VT_PROBE_TIMEOUT_SECONDS=60
VT_WORKER_LEASE_SECONDS=60
VT_WORKER_HEARTBEAT_SECONDS=15
VT_WORKER_POLL_SECONDS=2
VT_SESSION_TTL_SECONDS=604800
VT_LOGIN_MAX_ATTEMPTS=5
VT_LOGIN_WINDOW_SECONDS=900
VT_PROVIDER_ALLOWED_HOSTS=
VT_PROVIDER_PROXY_URL=
VT_PROVIDER_DNS_OVER_HTTPS=false

# Compose/build metadata. Set image tags to tested immutable digests for promotion.
VT_SOURCE_REVISION=unrecorded
VT_RUNTIME_IMAGE=video-translate-runtime:local
VT_WEB_IMAGE=video-translate-web:local
VT_WEB_PORT=8080
# Optional absolute path; relative env_file paths resolve from deploy/compose.yaml.
# VT_RUNTIME_ENV_FILE=/etc/video-translate/runtime.env
