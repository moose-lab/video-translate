# Explicit local development only. Copy to .env; do not commit .env.
VT_ENVIRONMENT=development
VT_DATABASE_URL=sqlite:///var/videotranslate.db
VT_STORAGE_BACKEND=local
VT_LOCAL_STORAGE_ROOT=var/media
VT_SERVER_SECRET=development-only-secret-do-not-use-in-production
VT_PUBLIC_ORIGIN=http://localhost:8000
VT_DEBUG=false
VT_UPLOAD_MAX_BYTES=536870912
VT_SESSION_TTL_SECONDS=604800
VT_LOGIN_MAX_ATTEMPTS=5
VT_LOGIN_WINDOW_SECONDS=900

# Production requires PostgreSQL, HTTPS public origin, debug=false, and private S3.
# Generate a server secret with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# VT_ENVIRONMENT=production
# VT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
# VT_STORAGE_BACKEND=s3
# VT_SERVER_SECRET=
# VT_PUBLIC_ORIGIN=https://video.example.com
VT_S3_ENDPOINT_URL=
VT_S3_BUCKET=
VT_S3_REGION=
VT_S3_ACCESS_KEY=
VT_S3_SECRET_KEY=

# Independent worker and bounded CPU media probe
VT_WORKER_LEASE_SECONDS=60
VT_WORKER_HEARTBEAT_SECONDS=15
VT_WORKER_POLL_SECONDS=2
VT_PROBE_MAX_BYTES=536870912
VT_PROBE_MAX_DURATION_SECONDS=14400
VT_PROBE_MAX_PIXELS=33177600
VT_PROBE_TIMEOUT_SECONDS=60

# Comma-separated hostnames explicitly approved by the administrator for custom providers.
# VT_PROVIDER_ALLOWED_HOSTS=

# Optional administrator-only proxy. HTTP is allowed only for loopback; HTTPS may use a trusted proxy.
# Optional trusted DNS over HTTPS uses Cloudflare via the configured proxy; it never receives provider credentials.
# VT_PROVIDER_PROXY_URL=http://127.0.0.1:7897
# VT_PROVIDER_DNS_OVER_HTTPS=true
